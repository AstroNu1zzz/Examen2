<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.ManageUnitsPage"
             Title="Configurar Unidades"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="18" MaximumWidthRequest="500">
            <Label Text="Organización del Curso" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
            <Label Text="Define los periodos o unidades de evaluación con sus fechas límite." FontSize="13" TextColor="#64748B" />

            <!-- FORMULARIO CREAR UNIDAD -->
            <Border Padding="16" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                <VerticalStackLayout Spacing="12">
                    <Entry x:Name="TxtUnitTitle" Placeholder="Nombre (ej. Unidad 1: Fundamentos)" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Fecha Inicio:" FontSize="12" TextColor="#64748B" />
                            <DatePicker x:Name="DpStart" Format="dd/MM/yyyy" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Fecha Fin:" FontSize="12" TextColor="#64748B" />
                            <DatePicker x:Name="DpEnd" Format="dd/MM/yyyy" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="+ Agregar Unidad" BackgroundColor="#5EEAD4" TextColor="#0F172A" FontAttributes="Bold" Clicked="OnAddUnitClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- LISTA DE UNIDADES REGISTRADAS -->
            <Label Text="Unidades Registradas" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" Margin="0,10,0,0" />

            <CollectionView x:Name="CvUnits" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4" Padding="14" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                    <Label Text="{Binding StartDate, StringFormat='Del {0:dd/MM/yyyy}'}" FontSize="12" TextColor="#64748B" />
                                    <Label Text="{Binding EndDate, StringFormat='Al {0:dd/MM/yyyy}'}" FontSize="12" TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="📅" FontSize="20" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>