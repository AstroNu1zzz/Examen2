<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.CourseDetailPage"
             BackgroundColor="#F8F9FA"
             Title="{Binding CourseName}">

    <Grid RowDefinitions="*, Auto">

        <!-- ÁREA DE CONTENIDO VARIABLE DE PESTAÑAS -->
        <Grid Grid.Row="0">

            <!-- PESTAÑA 1: TABLÓN / NOVEDADES -->
            <ScrollView x:Name="ViewTablon" Padding="16" IsVisible="True">
                <VerticalStackLayout Spacing="16">
                    <!-- Banner de la clase -->
                    <Border BackgroundColor="{Binding ThemeColor}" Padding="20" HeightRequest="120" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout VerticalOptions="End">
                            <Label Text="{Binding CourseName}" FontSize="22" FontAttributes="Bold" TextColor="White" />
                            <Label Text="{Binding PrimaryTeacherName, StringFormat='Profesor: {0}'}" FontSize="13" TextColor="White" Opacity="0.9" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lista de publicaciones (Anuncios, Materiales, Tareas) -->
                    <Label Text="Novedades de la clase" FontSize="16" FontAttributes="Bold" TextColor="#202124" />

                    <CollectionView x:Name="LstTablonItems" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="14">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Text="{Binding AuthorName}" FontAttributes="Bold" FontSize="13" TextColor="#1A73E8" />
                                            <Label Grid.Column="1" Text="{Binding ItemType}" FontSize="11" TextColor="#5F6368" />
                                        </Grid>
                                        <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="#202124" />
                                        <Label Text="{Binding Description}" FontSize="13" TextColor="#3C4043" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>

            <!-- PESTAÑA 2: TRABAJO DE CLASE -->
            <ScrollView x:Name="ViewTrabajo" Padding="16" IsVisible="False">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Trabajo de clase" FontSize="18" FontAttributes="Bold" TextColor="#202124" />

                    <CollectionView x:Name="LstTrabajoItems" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="14">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                        <Label Text="📝" FontSize="22" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="#202124" />
                                            <Label Text="{Binding Description}" FontSize="12" TextColor="#5F6368" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding DueDate, StringFormat='Fecha limite: {0:dd/MM/yyyy}'}" FontSize="11" TextColor="#D93025" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>

            <!-- PESTAÑA 3: PERSONAS -->
            <ScrollView x:Name="ViewPersonas" Padding="16" IsVisible="False">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Profesores" FontSize="18" FontAttributes="Bold" TextColor="#1A73E8" />
                    <CollectionView x:Name="LstTeachers">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Spacing="12" Padding="8,4">
                                    <Label Text="👤" FontSize="18" VerticalOptions="Center" />
                                    <Label Text="{Binding Username}" FontSize="15" TextColor="#202124" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1" Color="#E0E0E0" />

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Alumnos" FontSize="18" FontAttributes="Bold" TextColor="#1A73E8" />
                        <Button Grid.Column="1" Text="＋ Añadir" Clicked="OnAddTeacherClicked" BackgroundColor="Transparent" TextColor="#1A73E8" FontSize="12" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

            <!-- BOTÓN FLOTANTE MÁS (+) PARA CREAR CONTENIDO -->
            <Button Text="＋ Crear"
                    Clicked="OnCreateContentClicked"
                    BackgroundColor="#1A73E8"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="14"
                    CornerRadius="24"
                    HeightRequest="48"
                    Padding="16,0"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,20,20" />
        </Grid>

        <!-- BARRA DE NAVEGACIÓN INFERIOR (BOTTOM TAB BAR) -->
        <Border Grid.Row="1" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="0">
            <Grid ColumnDefinitions="*, *, *">
                <Button x:Name="BtnTabTablon"
                        Grid.Column="0"
                        Text="💬 Tablón"
                        Clicked="OnTablonTabClicked"
                        BackgroundColor="Transparent"
                        TextColor="#1A73E8"
                        FontAttributes="Bold" />

                <Button x:Name="BtnTabTrabajo"
                        Grid.Column="1"
                        Text="📚 Trabajos"
                        Clicked="OnTrabajoTabClicked"
                        BackgroundColor="Transparent"
                        TextColor="#5F6368" />

                <Button x:Name="BtnTabPersonas"
                        Grid.Column="2"
                        Text="👥 Personas"
                        Clicked="OnPersonasTabClicked"
                        BackgroundColor="Transparent"
                        TextColor="#5F6368" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>