<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.CourseDetailPage"
             Title="{Binding CourseName}">

    <VerticalStackLayout Padding="30" Spacing="15">
        <Border BackgroundColor="{Binding ThemeColor}" Padding="20" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <VerticalStackLayout>
                <Label Text="{Binding CourseName}" FontSize="28" FontAttributes="Bold" TextColor="White" />
                <Label Text="{Binding TeacherName}" FontSize="16" TextColor="White" />
            </VerticalStackLayout>
        </Border>

        <Label Text="Anuncios y tareas de la clase" FontSize="20" FontAttributes="Bold" Margin="0,10,0,0"/>
        <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="15">
            <Label Text="No hay anuncios publicados aún en esta materia." TextColor="Gray" />
        </Border>
    </VerticalStackLayout>
</ContentPage>