<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.CourseDetailPage"
             Title="Detalle del Curso"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <LinearGradientBrush x:Key="WorkflowBrandBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5C93F9" Offset="0.0" />
                <GradientStop Color="#5EEAD4" Offset="0.6" />
                <GradientStop Color="#86EFAC" Offset="1.0" />
            </LinearGradientBrush>

            <Shadow x:Key="FeedShadow" Brush="#000000" Opacity="0.08" Offset="0,2" Radius="8" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- BARRA SUPERIOR FIJA -->
        <Border Grid.Row="0"
                Padding="16,10"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.06" Offset="0,2" Radius="6" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">
                <ImageButton Grid.Column="0"
                             Source="icon_arrow_back.png"
                             WidthRequest="24"
                             HeightRequest="24"
                             BackgroundColor="Transparent"
                             Clicked="OnBackButtonClicked" />

                <Label Grid.Column="1"
                       Text="{Binding Course.CourseName}"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                <ImageButton Grid.Column="2"
                             Source="icon_videocam.png"
                             WidthRequest="22"
                             HeightRequest="22"
                             BackgroundColor="Transparent"
                             Clicked="OnVideoCallClicked" />

                <ImageButton Grid.Column="3"
                             Source="icon_info.png"
                             WidthRequest="22"
                             HeightRequest="22"
                             BackgroundColor="Transparent"
                             Clicked="OnCourseInfoClicked" />
            </Grid>
        </Border>

        <!-- CONTENEDOR CENTRAL -->
        <Grid Grid.Row="1">

            <!-- VISTA 1: NOVEDADES -->
            <ScrollView x:Name="ViewNovedades" IsVisible="True">
                <VerticalStackLayout Spacing="16" Padding="16,12,16,24">

                    <!-- Banner de Portada -->
                    <Border HeightRequest="150"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            Shadow="{StaticResource FeedShadow}">
                        <Grid>
                            <Image Source="{Binding Course.BannerImagePath}"
                                   Aspect="AspectFill"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />

                            <Border StrokeThickness="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#30000000" Offset="0.0" />
                                        <GradientStop Color="#800F172A" Offset="0.5" />
                                        <GradientStop Color="#F00F172A" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Grid Padding="20" RowDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Row="1" Spacing="4">
                                        <Label Text="{Binding Course.CourseName}" 
                                               FontSize="24" 
                                               FontAttributes="Bold" 
                                               TextColor="White" />
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="{Binding Course.DisplayTeacherName, StringFormat='Prof. {0}'}" FontSize="13" FontAttributes="Bold" TextColor="#5EEAD4" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Caja Anunciar -->
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,12"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}"
                            Shadow="{StaticResource FeedShadow}">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    StrokeShape="RoundRectangle 18"
                                    StrokeThickness="1.5"
                                    Stroke="#5EEAD4">
                                <Label Text="✏️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <Label Grid.Column="1"
                                   Text="Anunciar algo a tu clase..."
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCreatePostTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <!-- Feed Novedades -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FeedPosts}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                    StrokeShape="RoundRectangle 14"
                    Padding="16"
                    Background="{Binding CardGradientBrush}"
                    Shadow="{StaticResource FeedShadow}">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFeedPostTapped" />
                                    </Border.GestureRecognizers>

                                    <!-- CAMBIO: RowDefinitions pasa a "Auto, Auto, Auto, Auto" -->
                                    <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="8">

                                        <!-- FILA 0: ENCABEZADO (ÍCONO, TÍTULO Y FECHA) -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                                            <Border Grid.Column="0"
                                WidthRequest="42"
                                HeightRequest="42"
                                StrokeShape="RoundRectangle 21"
                                StrokeThickness="0"
                                BackgroundColor="{Binding IconBgColor}">
                                                <Label Text="{Binding IconSymbol}"
                                   FontSize="18"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Title}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                                <Label Text="{Binding DateFormatted}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                            </VerticalStackLayout>

                                            <ImageButton Grid.Column="2"
                                     Source="icon_more_vert.png"
                                     WidthRequest="20"
                                     HeightRequest="20"
                                     BackgroundColor="Transparent"
                                     Clicked="OnPostOptionsClicked" />
                                        </Grid>

                                        <!-- FILA 1: TEXTO / CONTENIDO DEL ANUNCIO -->
                                        <Label Grid.Row="1"
                           Text="{Binding Description}"
                           IsVisible="{Binding HasDescription}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}"
                           LineBreakMode="WordWrap"
                           Margin="0,2,0,4" />

                                        <!-- FILA 2: FECHA DE ENTREGA (SOLO TAREAS) -->
                                        <HorizontalStackLayout Grid.Row="2" IsVisible="{Binding IsAssignment}">
                                            <Border Padding="8,4"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="#FEE2E2">
                                                <Label Text="{Binding DueDateText}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#D93025" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <!-- FILA 3: SEPARADOR Y COMENTARIOS -->
                                        <Grid Grid.Row="3" ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                            <BoxView HeightRequest="1" 
                                 Color="{AppThemeBinding Light=#F1F5F9, Dark=#272E38}" 
                                 VerticalOptions="Center" />

                                            <Label Grid.Column="1"
                               Text="{Binding CommentsCountText}"
                               FontSize="12"
                               Margin="10,0,0,0"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                        </Grid>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- VISTA 2: TRABAJOS DE CLASE -->
            <ScrollView x:Name="ViewTrabajos" IsVisible="False">
                <VerticalStackLayout Spacing="20" Padding="16,16,16,24">
                    <Label Text="Trabajos y Actividades" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding AssignmentPosts}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="14"
                                        Background="{Binding CardGradientBrush}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFeedPostTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                        <Border Grid.Column="0" WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 19" BackgroundColor="{Binding IconBgColor}" StrokeThickness="0">
                                            <Label Text="{Binding IconSymbol}" FontSize="16" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                            <Label Text="{Binding DueDateText}" FontSize="11" TextColor="#D93025" IsVisible="{Binding IsAssignment}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- VISTA 3: PERSONAS -->
            <ScrollView x:Name="ViewPersonas" IsVisible="False">
                <VerticalStackLayout Spacing="20" Padding="16,16,16,24">
                    <Label Text="Profesor" FontSize="18" FontAttributes="Bold" TextColor="#5EEAD4" />
                    <Border StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" Padding="14,10" BackgroundColor="White">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="👨‍🏫" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Course.DisplayTeacherName, StringFormat='Prof. {0}'}" FontAttributes="Bold" FontSize="14" TextColor="Black" />
                                <Label Text="Profesor Titular" FontSize="12" TextColor="#64748B" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- BOTÓN FLOTANTE MÁS (+) PARA PUBLICAR -->
            <Border HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,20,20"
                    WidthRequest="56"
                    HeightRequest="56"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="0"
                    Background="{StaticResource WorkflowBrandBrush}"
                    Shadow="{StaticResource FeedShadow}"
                    ZIndex="99">
                <Grid>
                    <Label Text="+"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="0,-2,0,0" />
                    <Button BackgroundColor="Transparent"
                            Clicked="OnCreatePostOptionsClicked" />
                </Grid>
            </Border>

        </Grid>

        <!-- BARRA DE NAVEGACIÓN INFERIOR -->
        <Border Grid.Row="2"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#272E38}"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}"
                Padding="0,6,0,10">
            <Grid ColumnDefinitions="*, *, *">

                <!-- Pestaña 1: Novedades -->
                <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                    <Label Text="📢" FontSize="20" HorizontalOptions="Center" />
                    <Label x:Name="TabNovedadesLabel"
                           Text="Novedades" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           TextColor="#5EEAD4" 
                           HorizontalOptions="Center" />
                    <BoxView x:Name="TabNovedadesIndicator"
                             HeightRequest="3" 
                             WidthRequest="28" 
                             Color="#5EEAD4" 
                             CornerRadius="1.5" />

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabNovedadesTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Pestaña 2: Trabajos -->
                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                    <Label Text="📋" FontSize="20" HorizontalOptions="Center" />
                    <Label x:Name="TabTrabajosLabel"
                           Text="Trabajos" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                           HorizontalOptions="Center" />
                    <BoxView x:Name="TabTrabajosIndicator"
                             HeightRequest="3" 
                             WidthRequest="28" 
                             Color="Transparent" 
                             CornerRadius="1.5" />

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTrabajosTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Pestaña 3: Personas -->
                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                    <Label Text="👥" FontSize="20" HorizontalOptions="Center" />
                    <Label x:Name="TabPersonasLabel"
                           Text="Personas" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                           HorizontalOptions="Center" />
                    <BoxView x:Name="TabPersonasIndicator"
                             HeightRequest="3" 
                             WidthRequest="28" 
                             Color="Transparent" 
                             CornerRadius="1.5" />

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabPersonasTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>