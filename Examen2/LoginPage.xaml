<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.LoginPage"
             BackgroundColor="#F8F9FA"
             NavigationPage.HasNavigationBar="False">

    <Grid VerticalOptions="Center" HorizontalOptions="Center">
        <Border BackgroundColor="White"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                WidthRequest="380"
                Padding="30">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="18">
                <!-- Header logo / titulo -->
                <Label Text="Classroom"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#1A73E8"
                       HorizontalOptions="Center" />

                <Label Text="Iniciar sesión"
                       FontSize="18"
                       TextColor="#3C4043"
                       HorizontalOptions="Center" />

                <!-- Campo Usuario / Correo -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Usuario o Correo" FontSize="12" TextColor="#5F6368" />
                    <Entry x:Name="TxtUser"
                           Placeholder="ejemplo@cecyt13.ipn.mx"
                           Text="alumno@cecyt13.ipn.mx" />
                </VerticalStackLayout>

                <!-- Campo Contraseña -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Contraseña" FontSize="12" TextColor="#5F6368" />
                    <Entry x:Name="TxtPassword"
                           IsPassword="True"
                           Text="123" />
                </VerticalStackLayout>

                <!-- Botón de Ingreso -->
                <Button Text="Siguiente"
                        BackgroundColor="#1A73E8"
                        TextColor="White"
                        CornerRadius="6"
                        HeightRequest="42"
                        Margin="0,10,0,0"
                        Clicked="OnLoginClicked" />
                <Button Text="Crear cuenta"
        BackgroundColor="Transparent"
        TextColor="#1A73E8"
        FontSize="13"
        Clicked="OnRegisterNavigationClicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>