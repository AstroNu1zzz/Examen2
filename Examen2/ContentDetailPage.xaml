<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.ContentDetailPage"
             BackgroundColor="#F8F9FA">

    <ScrollView Padding="30">
        <VerticalStackLayout Spacing="20">

            <!-- ENCABEZADO SUPERIOR -->
            <Grid ColumnDefinitions="*, Auto">
                <Label x:Name="LblTopType" Text="Tarea" FontSize="18" FontAttributes="Bold" TextColor="#202124" VerticalOptions="Center" />

                <!-- Envolvemos el Label en un Border para aplicar el CornerRadius -->
                <Border Grid.Column="1" BackgroundColor="#1E3A5F" StrokeThickness="0" IsVisible="{Binding Source={x:Reference LblSubmissionStatusTop}, Path=IsVisible}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label x:Name="LblSubmissionStatusTop" Text="Asignada" TextColor="White" Padding="10,4" FontSize="12" FontAttributes="Bold" IsVisible="False" />
                </Border>
            </Grid>

            <!-- CONTENIDO PRINCIPAL Y PANEL LATERAL -->
            <Grid ColumnDefinitions="7*, 3*" ColumnSpacing="20">

                <!-- COLUMNA IZQUIERDA: INSTRUCCIONES Y MATERIALES -->
                <VerticalStackLayout Grid.Column="0" Spacing="20">
                    <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="25">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label x:Name="LblTitle" FontSize="22" FontAttributes="Bold" TextColor="#202124" />
                            <HorizontalStackLayout Spacing="10">
                                <Label x:Name="LblDueDate" FontSize="13" TextColor="#FF5252" IsVisible="False" />
                                <Label Text="•" FontSize="13" TextColor="#9AA0A6" />
                                <Label x:Name="LblPoints" FontSize="13" TextColor="#5F6368" />
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10" />

                            <Label Text="Instrucciones:" FontSize="14" FontAttributes="Bold" TextColor="#202124" />
                            <Label x:Name="LblDescription" FontSize="14" TextColor="#3C4043" LineHeight="1.5" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Materiales de referencia" FontSize="16" FontAttributes="Bold" TextColor="#202124" Margin="0,10,0,0" />
                    <Border x:Name="LayoutTeacherAttachment" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="15" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                            <Label Text="📄" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label x:Name="LblTeacherFileName" FontSize="14" FontAttributes="Bold" TextColor="#202124" />
                                <Label Text="Documento" FontSize="11" TextColor="#5F6368" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Ver" Clicked="OnOpenTeacherFileClicked" BackgroundColor="Transparent" TextColor="#1A73E8" FontAttributes="Bold" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- COLUMNA DERECHA: ENTREGA (OCULTA EN MATERIALES) -->
                <VerticalStackLayout Grid.Column="1" Spacing="20">
                    <Border x:Name="BorderStudentSubmission" BackgroundColor="White" Stroke="#48E5C2" StrokeThickness="1" Padding="20" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="15">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Tu trabajo" FontSize="18" FontAttributes="Bold" TextColor="#202124" />
                                <Label x:Name="LblSubmissionStatus" Grid.Column="1" Text="Sin entregar" FontSize="12" TextColor="#48E5C2" VerticalOptions="Center" />
                            </Grid>

                            <Button Text="＋ Agregar trabajo o archivo" Clicked="OnPickSubmissionFileClicked" BackgroundColor="White" TextColor="#1A73E8" BorderColor="#1A73E8" BorderWidth="1" CornerRadius="8" HeightRequest="45" />
                            <Label x:Name="LblSubmittedFileName" FontSize="12" TextColor="#1E8E3E" FontAttributes="Italic" IsVisible="False" />
                            <Button x:Name="BtnSubmit" Text="Entregar tarea" Clicked="OnSubmitTaskClicked" BackgroundColor="#48E5C2" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="45" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Comentarios privados" FontSize="14" FontAttributes="Bold" TextColor="#202124" />
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Entry Placeholder="Añadir comentario..." FontSize="13" />
                                <Button Grid.Column="1" Text="Enviar" BackgroundColor="#48E5C2" TextColor="White" CornerRadius="8" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>