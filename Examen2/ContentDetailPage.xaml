<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.ContentDetailPage"
             Title="Detalle"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20" MaximumWidthRequest="700">

            <!-- CABECERA -->
            <Border Padding="20"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label x:Name="LblTopType"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#5EEAD4" />

                        <Label x:Name="LblSubmissionStatusTop"
                               Grid.Column="1"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#5EEAD4" />
                    </Grid>

                    <Label x:Name="LblTitle"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                    <HorizontalStackLayout x:Name="StackPoints" Spacing="8">
                        <Label x:Name="LblPoints"
                               FontSize="13"
                               TextColor="#64748B" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" Margin="0,4" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Instrucciones:"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                        <Label x:Name="LblDescription"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                    </VerticalStackLayout>

                    <Label x:Name="LblDueDate"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#F87171"
                           IsVisible="False"
                           Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- MATERIALES DE REFERENCIA DEL PROFESOR -->
            <VerticalStackLayout x:Name="LayoutTeacherAttachmentSection" Spacing="10" IsVisible="False">
                <Label Text="Materiales de referencia"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                <Border x:Name="LayoutTeacherAttachment"
                        Padding="14"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Label Text="📄" FontSize="22" VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label x:Name="LblTeacherFileName"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   LineBreakMode="MiddleTruncation"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            <Label Text="Documento adjunto"
                                   FontSize="11"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="Ver"
                                FontSize="12"
                                TextColor="#5EEAD4"
                                BackgroundColor="Transparent"
                                Clicked="OnOpenTeacherFileClicked" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- SECCIÓN TU TRABAJO (ALUMNO) -->
            <Border x:Name="BorderStudentSubmission"
                    Padding="18"
                    StrokeThickness="1.5"
                    Stroke="#5EEAD4"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">

                <VerticalStackLayout Spacing="14">

                    <!-- CABECERA DE TU TRABAJO -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Tu trabajo"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                        <Label x:Name="LblSubmissionStatus"
                               Grid.Column="1"
                               Text="Sin entregar"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#EF4444" />
                    </Grid>

                    <!-- PUNTUACIÓN DE LA CALIFICACIÓN -->
                    <Border x:Name="BorderGradeBadge"
                            IsVisible="False"
                            Padding="12,8"
                            HorizontalOptions="Start"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="#132A2B">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="⭐ Calificación:" FontSize="13" FontAttributes="Bold" TextColor="#5EEAD4" />
                            <Label x:Name="LblGradeScore" FontSize="14" FontAttributes="Bold" TextColor="White" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- RETROALIMENTACIÓN DEL PROFESOR -->
                    <Border x:Name="BorderFeedback"
                            IsVisible="False"
                            Padding="14"
                            StrokeThickness="1"
                            Stroke="#5EEAD4"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#F0FDFA, Dark=#132A2B}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="💬 Comentarios del profesor:" FontAttributes="Bold" FontSize="12" TextColor="#5EEAD4" />
                            <Label x:Name="LblTeacherFeedback" FontSize="13" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- ARCHIVO SUBIDO POR EL ALUMNO -->
                    <Border x:Name="LayoutStudentAttachment"
                            IsVisible="False"
                            Padding="12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#181D23}">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Text="📄" FontSize="20" VerticalOptions="Center" />
                            <Label x:Name="LblSubmittedFileName"
                                   Grid.Column="1"
                                   FontSize="12"
                                   LineBreakMode="MiddleTruncation"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            <Button Grid.Column="2"
                                    Text="Ver"
                                    FontSize="12"
                                    TextColor="#5EEAD4"
                                    BackgroundColor="Transparent"
                                    Clicked="OnOpenSubmittedFileClicked" />
                        </Grid>
                    </Border>

                    <!-- BOTONES DE ACCIÓN -->
                    <Button x:Name="BtnAddFile"
                            Text="+ Agregar trabajo o archivo"
                            BackgroundColor="Transparent"
                            TextColor="#5EEAD4"
                            BorderColor="#5EEAD4"
                            BorderWidth="1"
                            CornerRadius="8"
                            Clicked="OnAddFileClicked" />

                    <Button x:Name="BtnSubmit"
                            Text="Entregar tarea"
                            BackgroundColor="#5EEAD4"
                            TextColor="#0F172A"
                            FontAttributes="Bold"
                            HeightRequest="44"
                            CornerRadius="10"
                            Clicked="OnSubmitTaskClicked" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>