<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.ContentDetailPage"
             Title="Detalle"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <!-- ENCABEZADO SUPERIOR -->
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <Label x:Name="LblTopType" 
                       Text="Tarea" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" 
                       VerticalOptions="Center" />

                <Border Grid.Column="1" 
                        BackgroundColor="#1E3A5F" 
                        StrokeThickness="0" 
                        IsVisible="{Binding Source={x:Reference LblSubmissionStatusTop}, Path=IsVisible}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label x:Name="LblSubmissionStatusTop" 
                           Text="Asignada" 
                           TextColor="White" 
                           Padding="12,5" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           IsVisible="False" />
                </Border>
            </Grid>

            <!-- 1. INSTRUCCIONES -->
            <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}" 
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" 
                    StrokeThickness="1" 
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="LblTitle" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                    <HorizontalStackLayout x:Name="StackPoints" 
                       IsVisible="{Binding ContentItem.IsTask}">
                        <Label Text="•" 
           FontSize="13" 
           TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" />
                        <Label x:Name="LblPoints"
           FontSize="13"
           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" Margin="0,4" />

                    <Label Text="Instrucciones:" 
                           FontSize="15" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                    <Label x:Name="LblDescription" 
                           FontSize="14" 
                           TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" 
                           LineHeight="1.4" />
                    <Label x:Name="LblDueDate"
       FontSize="13"
       FontAttributes="Bold"
       TextColor="#D93025"
       IsVisible="False" />
                </VerticalStackLayout>

            </Border>

            <!-- 2. MATERIALES DE REFERENCIA -->
            <VerticalStackLayout Spacing="10" x:Name="LayoutTeacherAttachmentSection">
                <Label Text="Materiales de referencia" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                <Border x:Name="LayoutTeacherAttachment" 
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}" 
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" 
                        StrokeThickness="1" 
                        Padding="14" 
                        IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E293B}" StrokeThickness="0">
                            <Label Text="📄" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="LblTeacherFileName" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" 
                                   LineBreakMode="TailTruncation" />
                            <Label Text="Documento adjunto" 
                                   FontSize="11" 
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" 
                                Text="Ver" 
                                Clicked="OnOpenTeacherFileClicked" 
                                BackgroundColor="Transparent" 
                                TextColor="#5C93F9" 
                                FontAttributes="Bold" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- 3. TU TRABAJO -->
            <Border x:Name="BorderStudentSubmission" 
        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}" 
        Stroke="#5EEAD4" 
        StrokeThickness="1.5" 
        Padding="20" 
        IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Tu trabajo" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                        <Label x:Name="LblSubmissionStatus" 
                   Grid.Column="1" 
                   Text="Sin entregar" 
                   FontSize="12" 
                   FontAttributes="Bold"
                   TextColor="#5EEAD4" 
                   VerticalOptions="Center" />
                    </Grid>

                    <Button Text="＋ Agregar trabajo o archivo" 
                Clicked="OnPickSubmissionFileClicked" 
                BackgroundColor="Transparent" 
                TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" 
                BorderColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" 
                BorderWidth="1" 
                CornerRadius="10" 
                HeightRequest="45" />

                    <!-- TARJETA ESTILIZADA PARA EL ARCHIVO SUBIDO POR EL ALUMNO -->
                    <Border x:Name="LayoutStudentAttachment"
                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}"
                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                StrokeThickness="1"
                Padding="12"
                IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Border WidthRequest="36" 
                        HeightRequest="36" 
                        StrokeShape="RoundRectangle 8" 
                        BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E293B}" 
                        StrokeThickness="0">
                                <Label Text="📄" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label x:Name="LblSubmittedFileName" 
                           FontSize="13" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" 
                           LineBreakMode="TailTruncation" />
                                <Label Text="Archivo adjunto" 
                           FontSize="11" 
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            </VerticalStackLayout>

                            <Button Grid.Column="2" 
                        Text="Ver" 
                        Clicked="OnOpenSubmittedFileClicked" 
                        BackgroundColor="Transparent" 
                        TextColor="#5C93F9" 
                        FontAttributes="Bold" />
                        </Grid>
                    </Border>

                    <Button x:Name="BtnSubmit" 
                Text="Entregar tarea" 
                Clicked="OnSubmitTaskClicked" 
                BackgroundColor="#5EEAD4" 
                TextColor="#0F172A" 
                FontAttributes="Bold" 
                CornerRadius="10" 
                HeightRequest="45" />
                </VerticalStackLayout>
            </Border>

            <!-- 4. COMENTARIOS PRIVADOS -->
            <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}" 
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" 
                    StrokeThickness="1" 
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Comentarios privados" 
                           FontSize="15" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Entry Placeholder="Añadir comentario..." 
                               PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                               BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}"
                               FontSize="13" />
                        <Button Grid.Column="1" 
                                Text="Enviar" 
                                BackgroundColor="#5EEAD4" 
                                TextColor="#0F172A" 
                                FontAttributes="Bold"
                                CornerRadius="8" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>