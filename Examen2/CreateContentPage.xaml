<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.CreateContentPage"
             BackgroundColor="#F8F9FA">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="16" HorizontalOptions="Center" MaximumWidthRequest="400">
            <Label x:Name="LblHeaderTitle" Text="Publicar en la clase" FontSize="22" FontAttributes="Bold" TextColor="#1A73E8" />

            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Título / Asunto" FontSize="12" TextColor="#5F6368" />
                        <Entry x:Name="TxtTitle" Placeholder="ej. Tarea 1: Ejercicios de derivadas" TextColor="#5F6368"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Instrucciones o contenido" FontSize="12" TextColor="#5F6368" />
                        <Editor x:Name="TxtDescription" Placeholder="Escribe aquí los detalles..." HeightRequest="100" TextColor="#5F6368"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="LayoutDueDate" Spacing="4" IsVisible="False">
                        <Label Text="Fecha de entrega" FontSize="12" TextColor="#5F6368" />
                        <DatePicker x:Name="DpDueDate" Background="AliceBlue"/>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelClicked" BackgroundColor="Transparent" TextColor="#5F6368" />
                        <Button Grid.Column="1" Text="Publicar" Clicked="OnPublishClicked" BackgroundColor="#1A73E8" TextColor="White" CornerRadius="6" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>