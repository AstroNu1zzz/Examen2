<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.MainPage"
             BackgroundColor="#F8F9FA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- BARRA LATERAL -->
        <Border Grid.Column="0" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1">
            <VerticalStackLayout Margin="10,20,10,10" Spacing="5">
                <Button Text="Inicio" Command="{Binding NavigateHomeCommand}" BackgroundColor="#E8F0FE" TextColor="#1967D2" FontAttributes="Bold" HorizontalOptions="Fill" />
                <Button Text="Calendar" Command="{Binding NavigateCalendarCommand}" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Fill" />

                <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,15,0,15" />

                <Label Text="Cursos en los que te has inscrito" FontAttributes="Bold" Margin="10,0,0,10" />
                <Button Text="Tareas pendientes" Command="{Binding NavigatePendingTasksCommand}" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Fill" />

                <!-- Lista dinámica de cursos en la barra lateral -->
                <CollectionView ItemsSource="{Binding EnrolledCourses}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding CourseName}" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCourseCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Fill" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,15,0,15" />
                <Button Text="Clases archivadas" Command="{Binding NavigateArchivedCommand}" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Fill" />
                <Button Text="Ajustes" Command="{Binding NavigateSettingsCommand}" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <ScrollView Grid.Column="1" Padding="30">
            <VerticalStackLayout Spacing="20">

                <!-- Tarjeta de próximas entregas -->
                <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid>
                        <Label Text="Fecha de entrega próxima" FontSize="18" HorizontalOptions="Start" />
                        <Label Text="{Binding NextDeadlineMessage}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#5F6368" />
                        <Button Text="Ver tarea pendiente" Command="{Binding ViewPendingTaskCommand}" HorizontalOptions="End" BackgroundColor="White" TextColor="#1A73E8" BorderColor="#1A73E8" BorderWidth="1" />
                    </Grid>
                </Border>

                <Label Text="Clases" FontSize="22" />

                <!-- Grid dinámico de Tarjetas de Clase -->
                <CollectionView ItemsSource="{Binding EnrolledCourses}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="20" HorizontalItemSpacing="20" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- El Border es clickeable a través de un TapGestureRecognizer -->
                            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" WidthRequest="300" HeightRequest="280">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCourseCommand}" 
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="100, *, Auto">
                                    <BoxView Grid.Row="0" Color="{Binding ThemeColor}" />
                                    <VerticalStackLayout Grid.Row="0" Padding="15">
                                        <Label Text="{Binding CourseName}" TextColor="White" FontSize="20" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding TeacherName}" TextColor="White" FontSize="12" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <BoxView Grid.Row="2" HeightRequest="1" Color="#E0E0E0" VerticalOptions="Start" />
                                    <HorizontalStackLayout Grid.Row="2" HorizontalOptions="End" Padding="10">
                                        <!-- Botón de carpeta para abrir archivos locales/nube -->
                                        <ImageButton Source="folder_icon.png" 
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCourseFilesCommand}"
                                                     CommandParameter="{Binding .}"
                                                     WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>