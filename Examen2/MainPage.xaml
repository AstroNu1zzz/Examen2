<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.MainPage"
             BackgroundColor="#F8F9FA"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- CONTENIDO PRINCIPAL -->
        <ScrollView Padding="30">
            <VerticalStackLayout Spacing="25">

                <!-- ENCABEZADO "Work Flow" -->
                <Grid ColumnDefinitions="*, Auto">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <!-- Simulación del logo vectorial -->
                        <Label Text="➿" FontSize="26" TextColor="#48E5C2" VerticalOptions="Center" />
                        <Label FontSize="22" VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Work " FontAttributes="Bold" TextColor="#202124" />
                                    <Span Text="Flow" FontAttributes="Bold" TextColor="#48E5C2" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </HorizontalStackLayout>

                    <!-- Menú de Perfil -->
                    <Border Grid.Column="1" WidthRequest="40" HeightRequest="40" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Grid>
                            <Button Text="{Binding UserInitial}" Command="{Binding ToggleProfileMenuCommand}" BackgroundColor="#1E3A5F" TextColor="White" FontAttributes="Bold" Padding="0" />
                            <Image Source="{Binding ProfileImageSource}" IsVisible="{Binding HasProfilePicture}" Aspect="AspectFill">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleProfileMenuCommand}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </Border>
                </Grid>

                <BoxView HeightRequest="1" Color="#E0E0E0" />

                <!-- MIS CLASES INSCRITAS (CARRUSEL HORIZONTAL) -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Mis Clases Inscritas" FontSize="18" FontAttributes="Bold" TextColor="#202124" />
                    <Label Grid.Column="1" Text="Ver todas" FontSize="14" TextColor="#1A73E8" VerticalOptions="Center" FontAttributes="Bold" />
                </Grid>

                <CollectionView ItemsSource="{Binding EnrolledCourses}" HeightRequest="140">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="20" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border WidthRequest="280" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCourseCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <!-- Imagen de fondo de la clase -->
                                    <Image Source="{Binding BannerImagePath}" Aspect="AspectFill" />
                                    <!-- Overlay oscuro para contraste -->
                                    <BoxView BackgroundColor="#99000000" />

                                    <VerticalStackLayout Padding="20" VerticalOptions="Fill" HorizontalOptions="Fill">
                                        <Label Text="{Binding CourseName}" FontSize="18" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="{Binding TeacherName, StringFormat='Prof. {0}'}" FontSize="12" TextColor="White" Opacity="0.8" VerticalOptions="EndAndExpand" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- TABLÓN GLOBAL DE NOVEDADES -->
                <Label Text="Tablón de Novedades" FontSize="18" FontAttributes="Bold" TextColor="#202124" Margin="0,15,0,0"/>

                <CollectionView ItemsSource="{Binding GlobalRecentActivities}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="#E0E0E0" StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>

                                <!-- Degradado dinámico desde C# -->
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="{Binding GradientStartColor}" Offset="0.0" />
                                        <GradientStop Color="#FFFFFF" Offset="0.8" />
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15" Padding="15">

                                    <!-- Círculo Oscuro con Ícono -->
                                    <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="#1E3A5F" StrokeThickness="0" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="22" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding IconString}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" />
                                    </Border>

                                    <!-- Datos de la Publicación -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                        <Label Text="{Binding DisplayTitle}" FontSize="15" FontAttributes="Bold" TextColor="#202124" />
                                        <Label Text="{Binding Subtitle}" FontSize="12" TextColor="#5F6368" />

                                        <!-- Etiqueta de fecha límite (Solo si existe) -->
                                        <Border BackgroundColor="#FFEBEB" StrokeThickness="0" HorizontalOptions="Start" Padding="8,4" Margin="0,4,0,0" IsVisible="{Binding HasDueDate}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="4" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding DueDateString}" FontSize="11" TextColor="#D93025" FontAttributes="Bold" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTÓN FLOTANTE MÁS (+) -->
        <Button Text="＋"
                Command="{Binding AddCourseCommand}"
                TextColor="#1E3A5F"
                FontSize="28"
                FontAttributes="Bold"
                CornerRadius="30"
                WidthRequest="60"
                HeightRequest="60"
                Padding="0"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,30,30">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#48E5C2" Offset="0.0" />
                    <GradientStop Color="#28B89C" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <!-- MENÚ FLOTANTE DE PERFIL -->
        <Border HorizontalOptions="End" VerticalOptions="Start" Margin="0,70,30,0" WidthRequest="240" BackgroundColor="White" Stroke="#CCCCCC" StrokeThickness="1" IsVisible="{Binding IsProfileMenuVisible}" ZIndex="100">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <VerticalStackLayout Padding="15" Spacing="8">
                <Label Text="{Binding CurrentUser.Username}" FontAttributes="Bold" FontSize="15" HorizontalOptions="Center" TextColor="#202124" />
                <Label Text="{Binding CurrentUser.Email}" FontSize="12" TextColor="#5F6368" HorizontalOptions="Center" />
                <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,5" />
                <Button Text="📷 Cambiar foto" Command="{Binding ChangeProfilePictureCommand}" BackgroundColor="Transparent" TextColor="#3C4043" HorizontalOptions="Start" />
                <Button Text="🚪 Cerrar sesión" Command="{Binding LogoutCommand}" BackgroundColor="Transparent" TextColor="#D93025" HorizontalOptions="Start" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>