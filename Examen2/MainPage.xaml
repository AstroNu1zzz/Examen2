<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.MainPage"
             BackgroundColor="#F8F9FA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- BARRA LATERAL -->
        <Border Grid.Column="0" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1">
            <VerticalStackLayout Margin="10,20,10,10" Spacing="5">
                <Button Text="Inicio" Command="{Binding NavigateHomeCommand}" BackgroundColor="#E8F0FE" TextColor="#1967D2" FontAttributes="Bold" HorizontalOptions="Fill" />
                <Button Text="Calendar" Command="{Binding NavigateCalendarCommand}" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Fill" />

                <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,15,0,15" />

                <Label Text="Cursos en los que te has inscrito" FontAttributes="Bold" Margin="10,0,0,10" />
                <Button Text="Tareas pendientes" Command="{Binding NavigatePendingTasksCommand}" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Fill" />

                <CollectionView ItemsSource="{Binding EnrolledCourses}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding CourseName}" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCourseCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Fill" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,15,0,15" />
                <Button Text="Clases archivadas" Command="{Binding NavigateArchivedCommand}" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Fill" />
                <Button Text="Ajustes" Command="{Binding NavigateSettingsCommand}" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Column="1">
            <ScrollView Padding="30">
                <VerticalStackLayout Spacing="20">

                    <!-- ENCABEZADO SUPERIOR CON ICONO DE PERFIL Y CREAR CLASE -->
                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="15">
                        <Label Text="Classroom" FontSize="24" FontAttributes="Bold" TextColor="#1A73E8" VerticalOptions="Center" />

                        <!-- Botón Crear Clase (+) -->
                        <Button Grid.Column="1"
                                Text="＋"
                                Command="{Binding AddCourseCommand}"
                                BackgroundColor="Transparent"
                                TextColor="#5F6368"
                                FontSize="24"
                                WidthRequest="45"
                                HeightRequest="45"
                                Padding="0"
                                ToolTipProperties.Text="Crear una clase" />

                        <!-- Avatar circular -->
                        <Grid Grid.Column="2" WidthRequest="45" HeightRequest="45">
                            <Button Text="{Binding UserInitial}"
                                    Command="{Binding ToggleProfileMenuCommand}"
                                    BackgroundColor="#1A73E8"
                                    TextColor="White"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    CornerRadius="22"
                                    WidthRequest="45"
                                    HeightRequest="45"
                                    Padding="0" />

                            <Image Source="{Binding ProfileImageSource}"
                                   IsVisible="{Binding HasProfilePicture}"
                                   Aspect="AspectFill"
                                   WidthRequest="45"
                                   HeightRequest="45">
                                <Image.Clip>
                                    <EllipseGeometry Center="22.5, 22.5" RadiusX="22.5" RadiusY="22.5" />
                                </Image.Clip>
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleProfileMenuCommand}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </Grid>

                    <!-- Tarjeta de próximas entregas -->
                    <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid>
                            <Label Text="Fecha de entrega próxima" FontSize="18" HorizontalOptions="Start" />
                            <Label Text="{Binding NextDeadlineMessage}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#5F6368" />
                            <Button Text="Ver tarea pendiente" Command="{Binding ViewPendingTaskCommand}" HorizontalOptions="End" BackgroundColor="White" TextColor="#1A73E8" BorderColor="#1A73E8" BorderWidth="1" />
                        </Grid>
                    </Border>

                    <Label Text="Clases" FontSize="22" />

                    <!-- Grid dinámico de Tarjetas de Clase -->
                    <CollectionView ItemsSource="{Binding EnrolledCourses}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="20" HorizontalItemSpacing="20" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" WidthRequest="300" HeightRequest="280">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCourseCommand}" 
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid RowDefinitions="100, *, Auto">
                                        <BoxView Grid.Row="0" Color="{Binding ThemeColor}" />
                                        <VerticalStackLayout Grid.Row="0" Padding="15">
                                            <Label Text="{Binding CourseName}" TextColor="White" FontSize="20" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding TeacherName}" TextColor="White" FontSize="12" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <BoxView Grid.Row="2" HeightRequest="1" Color="#E0E0E0" VerticalOptions="Start" />
                                        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="End" Padding="10" Spacing="5">
                                            <Button Text="📁" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCourseFilesCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent" />

                                            <Button Text="🗑" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCourseCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>

            <!-- MENÚ DESPLEGABLE FLOTANTE -->
            <Border HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,80,30,0"
                    WidthRequest="260"
                    BackgroundColor="White"
                    Stroke="#CCCCCC"
                    StrokeThickness="1"
                    IsVisible="{Binding IsProfileMenuVisible}"
                    ZIndex="100">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Padding="15" Spacing="8">
                    <!-- Nombre y correo del usuario -->
                    <Label Text="{Binding CurrentUser.Username}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" TextColor="#202124" />
                    <Label Text="{Binding CurrentUser.Email}" FontSize="12" TextColor="#5F6368" HorizontalOptions="Center" />

                    <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,5,0,5" />

                    <!-- Opción 1: Cambiar Foto -->
                    <Button Text="📷  Cambiar foto"
                            Command="{Binding ChangeProfilePictureCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#3C4043"
                            HorizontalOptions="Start" />

                    <!-- Opción 2: Cerrar Sesión -->
                    <Button Text="🚪  Cerrar sesión"
                            Command="{Binding LogoutCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#D93025"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>