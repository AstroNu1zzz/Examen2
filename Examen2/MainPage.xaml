<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.MainPage"
             BackgroundColor="#F8F9FA">

    <Grid>
        <!-- CONTENIDO PRINCIPAL EN 1 SOLA COLUMNA PARA MÓVIL -->
        <ScrollView Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- ENCABEZADO SUPERIOR -->
                <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <!-- Botón Hamburguesa -->
                    <Button Text="☰"
                            Command="{Binding ToggleDrawerCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#5F6368"
                            FontSize="22"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0" />

                    <!-- Título -->
                    <Label Grid.Column="1"
                           Text="Classroom"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#1A73E8"
                           VerticalOptions="Center" />

                    <!-- Botón Crear Clase (+) -->
                    <Button Grid.Column="2"
                            Text="＋"
                            Command="{Binding AddCourseCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#5F6368"
                            FontSize="24"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0" />

                    <!-- Avatar circular de perfil -->
                    <Grid Grid.Column="3" WidthRequest="40" HeightRequest="40">
                        <Button Text="{Binding UserInitial}"
                                Command="{Binding ToggleProfileMenuCommand}"
                                BackgroundColor="#1A73E8"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold"
                                CornerRadius="20"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0" />

                        <Image Source="{Binding ProfileImageSource}"
                               IsVisible="{Binding HasProfilePicture}"
                               Aspect="AspectFill"
                               WidthRequest="40"
                               HeightRequest="40">
                            <Image.Clip>
                                <EllipseGeometry Center="20, 20" RadiusX="20" RadiusY="20" />
                            </Image.Clip>
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleProfileMenuCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>

                <!-- TARJETA DE PRÓXIMAS ENTREGAS -->
                <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Fecha de entrega próxima" FontSize="16" FontAttributes="Bold" TextColor="#202124" />
                        <Label Text="{Binding NextDeadlineMessage}" FontSize="13" TextColor="#5F6368" />
                        <Button Text="Ver tarea pendiente"
                                Command="{Binding ViewPendingTaskCommand}"
                                HorizontalOptions="Start"
                                BackgroundColor="White"
                                TextColor="#1A73E8"
                                BorderColor="#1A73E8"
                                BorderWidth="1"
                                CornerRadius="4"
                                HeightRequest="36"
                                FontSize="13"
                                Padding="12,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- SECCIÓN DE CLASES -->
                <Label Text="Tus clases" FontSize="18" FontAttributes="Bold" TextColor="#3C4043" Margin="0,5,0,0" />

                <!-- LISTA VERTICAL DE TARJETAS -->
                <CollectionView ItemsSource="{Binding EnrolledCourses}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" HeightRequest="150" HorizontalOptions="Fill">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCourseCommand}" 
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="*, Auto">
                                    <Grid Grid.Row="0">
                                        <BoxView Color="{Binding ThemeColor}" />
                                        <VerticalStackLayout Padding="14,10" Spacing="2">
                                            <Label Text="{Binding CourseName}" TextColor="White" FontSize="18" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding TeacherName}" TextColor="White" FontSize="13" LineBreakMode="TailTruncation" Opacity="0.9" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Padding="10,4" BackgroundColor="White">
                                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                            <Button Text="📁" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCourseFilesCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent"
                                                    FontSize="16"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    Padding="0" />

                                            <Button Text="🗑" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCourseCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent"
                                                    FontSize="16"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    Padding="0" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- MENÚ LATERAL DESLIZANTE -->
        <Grid IsVisible="{Binding IsDrawerVisible}" ZIndex="200">
            <!-- Fondo oscuro para cerrar al tocar afuera -->
            <BoxView Color="#80000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleDrawerCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Panel del Menú Lateral -->
            <Border HorizontalOptions="Start" WidthRequest="270" BackgroundColor="White" StrokeThickness="0">
                <VerticalStackLayout Margin="16,30,16,16" Spacing="8">
                    <Label Text="Google Classroom" FontSize="20" FontAttributes="Bold" TextColor="#1A73E8" Margin="10,0,0,10" />

                    <Button Text="🏠  Inicio" Command="{Binding NavigateHomeCommand}" BackgroundColor="#E8F0FE" TextColor="#1967D2" FontAttributes="Bold" HorizontalOptions="Fill" />
                    <Button Text="📅  Calendario" Command="{Binding NavigateCalendarCommand}" BackgroundColor="Transparent" TextColor="#3C4043" HorizontalOptions="Fill" />

                    <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10" />

                    <Label Text="Cursos inscritos" FontAttributes="Bold" FontSize="12" TextColor="#5F6368" Margin="10,0,0,5" />
                    <Button Text="📋  Tareas pendientes" Command="{Binding NavigatePendingTasksCommand}" BackgroundColor="Transparent" TextColor="#3C4043" HorizontalOptions="Fill" />

                    <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10" />
                    <Button Text="📦  Clases archivadas" Command="{Binding NavigateArchivedCommand}" BackgroundColor="Transparent" TextColor="#3C4043" HorizontalOptions="Fill" />
                    <Button Text="⚙️  Ajustes" Command="{Binding NavigateSettingsCommand}" BackgroundColor="Transparent" TextColor="#3C4043" HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- MENÚ DESPLEGABLE DE PERFIL -->
        <Border HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,60,16,0"
                WidthRequest="240"
                BackgroundColor="White"
                Stroke="#CCCCCC"
                StrokeThickness="1"
                IsVisible="{Binding IsProfileMenuVisible}"
                ZIndex="300">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <VerticalStackLayout Padding="14" Spacing="6">
                <Label Text="{Binding CurrentUser.Username}" FontAttributes="Bold" FontSize="15" HorizontalOptions="Center" TextColor="#202124" />
                <Label Text="{Binding CurrentUser.Email}" FontSize="11" TextColor="#5F6368" HorizontalOptions="Center" />

                <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,4" />

                <Button Text="📷  Cambiar foto"
                        Command="{Binding ChangeProfilePictureCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#3C4043"
                        HorizontalOptions="Start" />

                <Button Text="🚪  Cerrar sesión"
                        Command="{Binding LogoutCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#D93025"
                        HorizontalOptions="Start" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>