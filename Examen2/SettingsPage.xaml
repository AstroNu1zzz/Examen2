<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.SettingsPage"
             Title="Ajustes"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#12161A}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="22" MaximumWidthRequest="600">

            <!-- TÍTULO DE LA PÁGINA -->
            <Label Text="Configuración" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" 
                   Margin="4,0" />

            <!-- SECCIÓN 1: PERFIL DE USUARIO -->
            <VerticalStackLayout Spacing="8">
                <Label Text="PERFIL" 
                       FontSize="12" 
                       FontAttributes="Bold" 
                       TextColor="#5EEAD4" 
                       Margin="4,0" />

                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                        StrokeShape="RoundRectangle 16"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">

                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <!-- Inicial / Foto de Perfil -->
                        <Border Grid.Column="0"
                                WidthRequest="48"
                                HeightRequest="48"
                                StrokeShape="RoundRectangle 24"
                                StrokeThickness="1.5"
                                Stroke="#5EEAD4"
                                BackgroundColor="#1E2B3C">
                            <Label Text="{Binding CurrentUser.Username[0]}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Datos del usuario -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding CurrentUser.Username, FallbackValue='Usuario'}" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            <Label Text="{Binding CurrentUser.Email, FallbackValue='correo@ejemplo.com'}" 
                                   FontSize="12" 
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- SECCIÓN 2: SEGURIDAD Y ACCESO -->
            <VerticalStackLayout Spacing="8">
                <Label Text="SEGURIDAD Y ACCESO" 
                       FontSize="12" 
                       FontAttributes="Bold" 
                       TextColor="#5EEAD4" 
                       Margin="4,0" />

                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                        StrokeShape="RoundRectangle 16"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">

                    <VerticalStackLayout Spacing="16">

                        <!-- OPTION 2FA -->
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Verificación de dos pasos (2FA)"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                <Label Text="Solicitar un código de verificación al iniciar sesión."
                                       FontSize="12"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>

                            <Switch x:Name="Switch2FA"
                                    Grid.Column="1"
                                    OnColor="#5EEAD4"
                                    ThumbColor="White"
                                    VerticalOptions="Center"
                                    Toggled="On2FAToggled" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- SECCIÓN 3: PREFERENCIAS -->
            <VerticalStackLayout Spacing="8">
                <Label Text="PREFERENCIAS" 
                       FontSize="12" 
                       FontAttributes="Bold" 
                       TextColor="#5EEAD4" 
                       Margin="4,0" />

                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                        StrokeShape="RoundRectangle 16"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">

                    <VerticalStackLayout Spacing="16">

                        <!-- NOTIFICACIONES POR CORREO -->
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Notificaciones por correo"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                <Label Text="Recibir correos sobre entregas y publicaciones."
                                       FontSize="12"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>

                            <Switch Grid.Column="1"
                                    IsToggled="True"
                                    OnColor="#5EEAD4"
                                    ThumbColor="White"
                                    VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- SECCIÓN 4: ACERCA DE LA APLICACIÓN -->
            <VerticalStackLayout Spacing="8">
                <Label Text="INFORMACIÓN" 
                       FontSize="12" 
                       FontAttributes="Bold" 
                       TextColor="#5EEAD4" 
                       Margin="4,0" />

                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                        StrokeShape="RoundRectangle 16"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E232B}">

                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="WorkFlow para MAUI" 
                                   FontAttributes="Bold" 
                                   FontSize="14" 
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            <Label Text="Versión 1.0.0 (Supabase Cloud)" 
                                   FontSize="12" 
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" 
                               Text="⚡" 
                               FontSize="20" 
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>