<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Examen2.AddCoursePage"
             Title="Crear clase"
             BackgroundColor="#F8F9FA">

    <ScrollView Padding="30">
        <VerticalStackLayout Spacing="20" HorizontalOptions="Center" WidthRequest="340">
            <Label Text="Crear una nueva clase" FontSize="22" FontAttributes="Bold" TextColor="#1A73E8" />

            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nombre de la clase (obligatorio)" FontSize="12" TextColor="#5F6368" />
                        <Entry x:Name="TxtCourseName" Placeholder="ej. DERECHO MERCANTIL 5IM6" />
                    </VerticalStackLayout>

                    <!-- Selector de Imagen de Fondo -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Imagen de fondo (Banner)" FontSize="12" TextColor="#5F6368" />
                        <Button Text="📷 Seleccionar Imagen" 
            Clicked="OnPickImageClicked" 
            BackgroundColor="#E8F0FE" 
            TextColor="#1967D2" 
            CornerRadius="8" />

                        <!-- Contenedor Border para redondear la imagen correctamente -->
                        <Border x:Name="BorderBannerPreview" 
            IsVisible="False" 
            Margin="0,10,0,0" 
            StrokeThickness="0" 
            HeightRequest="120">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Image x:Name="ImgBannerPreview" 
               Aspect="AspectFill" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,15,0,0">
                        <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelClicked" BackgroundColor="Transparent" TextColor="#5F6368" />
                        <Button Grid.Column="1" Text="Crear" Clicked="OnCreateCourseClicked" BackgroundColor="#48E5C2" TextColor="White" FontAttributes="Bold" CornerRadius="8" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>